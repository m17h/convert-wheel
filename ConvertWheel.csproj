<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ConvertWheel</AssemblyName>
    <RootNamespace>ConvertWheel</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Convert Wheel</Product>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Single-file publish: also embed native libraries (Skia), extracted on first run. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- The installer adds a private .NET runtime in "runtime\" only on PCs that lack .NET 10; look there first. -->
    <AppHostDotNetSearch>AppRelative;Global</AppHostDotNetSearch>
    <AppHostRelativeDotNet>runtime</AppHostRelativeDotNet>
    <!-- WPF reads DPI awareness from app.manifest; the WinForms tray menu follows it. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <!-- The icon is generated by the app itself (see README: export-icon switch). -->
  <PropertyGroup Condition="Exists('Assets\ConvertWheel.ico')">
    <ApplicationIcon>Assets\ConvertWheel.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.8.6" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="158.0.8125" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="Magick.NET-Q8-x64" Version="15.0.0" />
    <PackageReference Include="Markdig" Version="1.5.1" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="OggVorbisEncoder" Version="1.2.2" />
    <!-- Pinned: 6.2.x is the last MIT-licensed PDFsharp; later versions are AGPL. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="SharpCompress" Version="0.50.7" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!--
    FFmpeg (LGPL) is embedded compressed and unpacked on first use. The first build fetches and packs it
    (tools\pack-ffmpeg.ps1); pass -p:SkipFfmpegPack=true to build without it (e.g. offline).
  -->
  <Target Name="PackFfmpeg" BeforeTargets="PrepareForBuild" Condition="!Exists('tools\ffmpeg.tar.xz') And '$(SkipFfmpegPack)' != 'true'">
    <Message Importance="high" Text="Fetching the LGPL FFmpeg build and packing tools\ffmpeg.tar.xz (first build only)..." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\pack-ffmpeg.ps1&quot;" ContinueOnError="true" />
    <Warning Condition="!Exists('tools\ffmpeg.tar.xz')" Text="FFmpeg couldn't be packed (offline?). The app still builds; WebM, AVI, MPG and AC3 will then need an ffmpeg.exe next to the app or on PATH." />
  </Target>
  <Target Name="EmbedFfmpeg" BeforeTargets="AssignTargetPaths" AfterTargets="PackFfmpeg" Condition="Exists('tools\ffmpeg.tar.xz')">
    <ItemGroup>
      <EmbeddedResource Include="tools\ffmpeg.tar.xz" LogicalName="ffmpeg.tar.xz" />
    </ItemGroup>
  </Target>

  <!-- SkiaSharp's package ships a ~96 MB native debug-symbols file; it isn't needed to run. -->
  <Target Name="DropSkiaSymbols" AfterTargets="Publish">
    <Delete Files="$(PublishDir)libSkiaSharp.pdb" />
  </Target>

</Project>
